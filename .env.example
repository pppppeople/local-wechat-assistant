# Names and defaults only. This file is not automatically loaded.
# Set credentials in your own private shell/service configuration.
WECHAT_ASSISTANT_HOME=
# Default: ${XDG_DATA_HOME:-${HOME}/.local/share}/wechat-assistant-framework/runtime
WECHAT_BASE_URL=
WECHAT_ACCOUNT_ID=
WECHAT_OWNER_ID=
WECHAT_TOKEN=
# Optional: a complete HTTPS chat-completion endpoint supplied by you.
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=
# Default: 30000; integer milliseconds in the range 1000..120000.
MODEL_TIMEOUT_MS=30000
# Optional map library only; the default host does not read this value.
AMAP_WEB_SERVICE_KEY=

# Weather: relative state path resolves inside WECHAT_ASSISTANT_HOME.
WEATHER_STATE_FILE=
# Shanghai time; default 08:00. Host supplies timer and delivery.
WEATHER_MORNING_TIME=
